HOST=127.0.0.1
NODE_ENV=development
PORT=8787
# Development also allows localhost / 127.0.0.1 / [::1] on any port.
# Production must set NODE_ENV=production and list the actual site origins below.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://127.0.0.1:4173
AI_MODE=mock
# Set AI_MODE=live and fill in the server-side Bailian key to use a real model.
# These names match askLOL-serve. Never put the key in a VITE_* variable.
# BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_MODEL=qwen-plus
LLM_TIMEOUT_MS=60000
MAX_OUTPUT_TOKENS=2000
MAX_CONCURRENT_STREAMS=10
MOCK_CHUNK_DELAY_MS=25
KNOWLEDGE_FILE=data/knowledge.json
PROFILE_FILE=data/profile.json
