{
  "name": "jayzou-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "node scripts/check-env.mjs",
    "check:env": "node scripts/check-env.mjs",
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --import tsx --test tests/*.test.ts",
    "export:contracts": "node scripts/export-contracts.mjs",
    "import:knowledge": "node scripts/import-knowledge.mjs",
    "check": "npm run check:env && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "2.1.8",
    "ai": "7.0.173",
    "hono": "4.13.18",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "engines": { "node": ">=22.22.2 <23", "npm": ">=10.9.7 <11" },
  "packageManager": "npm@10.9.7"
}
